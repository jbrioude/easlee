#info
model = ERA5
format = grib
companions = _MET_>_CLD_
#3D
Ux = u
Vy = v
levdot = etadot
T = t
qv = q
rho = rho
zlev = zlev
puv = puv
# NB: convective mass-flux fields (umf/dmf/udr/ddr) deliberately OMITTED so the build
# falls back to the diagnostic (CAPE-based) convection scheme — diagconv — instead of
# the entrainment/detrainment mass-flux scheme.  Same ERA5 met as ERA5_CONV.vars.
#2D
sp = sp
lnsp = lnsp
2t = 2t
2d = 2d
z = z
lsm = lsm
ustar = zust
pblh = blh
cape = cape
