#info
# WRF wrfout with the TIME-AVERAGED mass-coupled fluxes (WRF namelist
# &dynamics do_avgflx_em = 1: AVGFLX_RUM, AVGFLX_RVM, AVGFLX_WWM, the means over
# each history interval).  Same reader as WRFv2.vars (metwrffieldcalculation!),
# winds decoupled with the column mass c1·(MU+MUB)+c2 and the map factors, and
# the vertical motion taken from WRF's own η̇ — mass-consistent by construction
# (the FLEXPART-WRF time-averaged wind option).  Thermodynamics stay those of
# the output time.  Prefer this namelist whenever the wrfout files carry AVGFLX.
wrf_winds = avgflx
model = WRF
format = NETCDF
#3D
Ux = AVGFLX_RUM   # mu-coupled u, x faces
Vy = AVGFLX_RVM   # mu-coupled v, y faces
levdot = 
W = AVGFLX_WWM    # mu-coupled eta-dot, w levels
T = T
qv = QVAPOR
rho = 
drhodz = 
zlev = 
p = P #pressure
pb = PB
ph = PH #geopotential height
phb = PHB
tke = #TKE_PBL
#2D
latitudes = XLAT
longitudes = XLONG
latitudes_u = XLAT_U
latitudes_v = XLAT_V
longitudes_u = XLONG_U
longitudes_v = XLONG_V
pblh = PBLH
ustar = UST
sp = PSFC
lsp =    
shf = HFX  # sensible heat flux, positive UPWARD in WRF
#ewss =     
#nsss =     
# 10u/10v (U10/V10) are not read: the surface slot takes the lowest level's wind
# and [physics] surface_layer_wind shapes it below that level (2026-10-21)
2t = T2
#2d = Q2
#z = z
lsm = LANDMASK
mu = MU
mub = MUB
