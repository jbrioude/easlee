#info
# WRF wrfout, Arakawa-C grid: metwrffieldcalculation! (io/metcalc_models.jl)
# destaggers U/V/W, rebuilds T from theta' and P+PB, puts the mass levels at
# their own heights above a surface slot, and derives tke from UST/PBLH/HFX.
# The map factor of the Lambert grid is applied analytically (met/coords.jl).
model = WRF
format = NETCDF
#3D
Ux = U
#AVGFLX_RUM = AVGFLX_RUM #wind along x axis
Vy = V
#AVGFLX_RVM = AVGFLX_RVM #wind along y axis
levdot = 
W = W
#AVGFLX_WWM = AVGFLX_WWM #wind across vertical levels
T = T
qv = QVAPOR
rho = 
drhodz = 
zlev = 
p = P #pressure
pb = PB
ph = PH #geopotential height
phb = PHB
tke = #TKE_PBL
#2D
latitudes = XLAT
longitudes = XLONG
latitudes_u = XLAT_U
latitudes_v = XLAT_V
longitudes_u = XLONG_U
longitudes_v = XLONG_V
pblh = PBLH
ustar = UST
sp = PSFC
lsp =    
shf = HFX  # sensible heat flux, positive UPWARD in WRF
#ewss =     
#nsss =     
# 10u/10v (U10/V10) are not read: the surface slot takes the lowest level's wind
# and [physics] surface_layer_wind shapes it below that level (2026-10-21)
2t = T2
#2d = Q2
#z = z
lsm = LANDMASK
