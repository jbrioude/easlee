#info
# CAPTEX ERA5 layout: IFS_EA_<date>_<base>_<step>.grb (3-D hybrid, incl. cloud +
# convection, hourly forecast steps) + IFS_SFC_<...>.grb surface companion.
# Same variable shortNames as ERA5_CONV; only the companion token differs.
model = ERA5
format = grib
companions = _EA_>_SFC_
#3D
Ux = u
Vy = v
levdot = etadot
T = t
qv = q
rho = rho
zlev = zlev
puv = puv
umf = avg_umf
dmf = avg_dmf
udr = avg_udr
ddr = avg_ddr
tpf = avg_tpf
cc = cc
ttlwr = avg_ttlwr
ttswr = avg_ttswr
#2D
lnsp = lnsp    # hybrid level-1 message; MUST be #2D so the reader derives sp=exp(lnsp)
sp = sp        # not in the CAPTEX files — slot allocated so the reader fills sp=exp(lnsp)
2t = 2t
2d = 2d
z = z
lsm = lsm
ustar = zust
pblh = blh
cape = cape
sshf = sshf    # surface sensible heat flux (MARS 146), hourly accumulation
