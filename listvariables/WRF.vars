# NOT SUPPORTED (2026-10-13): the AVGFLX variant (time-averaged mass-coupled
# fluxes AVGFLX_RUM/RVM/WWM).  It mapped zlev = ALT (inverse density) and divided
# by a column mass it never loaded; the WRF reader stops on it.  Use WRFv2.vars.
#info
model = WRF
format = NETCDF
#3D
Ux = AVGFLX_RUM #wind along x axis
Vy = AVGFLX_RVM #wind along y axis
levdot = AVGFLX_WWM #wind across vertical levels
T = T
qv = QVAPOR
rho = 
zlev = ALT
p = P #pressure
pb = PB
ph = PH #geopotential height
phb = PHB
tke =
#2D
latitudes = XLAT
longitudes = XLONG
latitudes_u = 
latitudes_v = 
longitudes_u =
longitudes_v =
pblh = PBLH
ustar = UST
sp = PSFC
lsp =    
sshf = HFX
mu = MU 
mub = MUB
ewss =     
nsss =     
10u = U10
10v = V10 
2t = T2
2d = Q2
z = 
lsm = 
