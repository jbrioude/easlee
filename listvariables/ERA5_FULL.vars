#info
# /data/ERA5_full layout: FULL_EA_* model-level files (u/v/t/q/etadot/lnsp/cc +
# convective avg_* + radiative avg_tt*) with FULL_SFC_* surface companions
# (2t/2d/blh/zust/z/lsm) at the same valid times.  FULL_PT_* isentropic winds
# are excluded from the main scan (auxiliary; pt_pattern = "FULL_PT" to use).
# Grid is GLOBAL −90…90 — pairs with [physics].polar_stereo_lat transport.
model = ERA5
format = grib
companions = _EA_>_SFC_
#3D
Ux = u
Vy = v
levdot = etadot
T = t
qv = q
rho = rho
zlev = zlev
puv = puv
umf = avg_umf
dmf = avg_dmf
udr = avg_udr
ddr = avg_ddr
tpf = avg_tpf
cc = cc
ttlwr = avg_ttlwr
ttswr = avg_ttswr
#2D
sp = sp
lnsp = lnsp
2t = 2t
2d = 2d
z = z
lsm = lsm
ustar = zust
pblh = blh
