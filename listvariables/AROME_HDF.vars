#info
model = AROME_HDF
format = grib
leveltype = height
multistep = true
companions = __HP1__>__SP1__, __HP1__>__SP2__, __HP1__>__SP3__
# Pressure-level package (IP1) stitched ABOVE the 3 km height ladder: the
# height-AGL Cartesian column (HP1) caps at 3 km, so isobaric u/v/t/r/z from IP1
# extend it to 100 hPa.  Handled specially (own isobaric level map), NOT a plain
# companion (different vertical coordinate).
pressure_companion = __HP1__>__IP1__
# No vertical velocity is disseminated: diagnosed from mass continuity on the
# stacked levels (continuity, default) or none (turbulence-only vertical transport).
vertical_velocity = continuity
#3D
Ux = u
Vy = v
T = t
rh = r
puv = pres
qv = qv
rho = rho
zlev = zlev
levdot = levdot
gz = z
#2D
2t = 2t
2r = 2r
prmsl = prmsl
sp = sp
pblh = blh
tauu = iews
tauv = inss
shf = sshf
ustar = ustar
ol = ol
