#info
model = MESONH
format = netcdf
tke_kind = e   # archived TKET is the FULL native TKE e (not the Hanna 0.5 sigw^2 fill)
vmix_rw = 0.25 # r_w : CBR vertical variance share, sigw^2 = 2*e*r_w   (Fix C)
vmix_ck = 0.16 # C_K : CBR SCALAR diffusivity constant, K_z = C_K*l*sqrt(e)  (Fix C)
#3D
Ux = UT
Vy = VT
levdot = WT
theta = THT
puv = PABST
rv = RVT
tke = TKET
qv = qv
rho = rho
zlev = zlev
T = T
#2D
zs = ZS
